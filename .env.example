# Copia este archivo como .env y llena tus valores (INICIAR.bat lo copia solo)
# En Render NO uses este archivo: los valores van en Environment del servicio.

# API key de YouTube Data API v3 (sin ella se pueden pegar links de YouTube)
YOUTUBE_API_KEY=

PORT=3000

# PIN de la pantalla del DJ. En internet usa 6+ dígitos.
ADMIN_PIN=1234

# Código de sala de 4 letras. Vacío = uno nuevo cada vez que arranca el servidor.
ROOM_CODE=

MAX_PER_PERSON=1
SEARCH_SUFFIX=karaoke
# Last.fm (gratis): clasifica artistas que no están en generos.js. https://www.last.fm/api/account/create
LASTFM_API_KEY=
# Reportes 🚩 de cels distintos para quitar una canción de la cola
REPORTS_TO_REMOVE=2

# 1 = solo se aceptan videos de karaoke (título o canal de karaoke). 0 = cualquier video
KARAOKE_ONLY=1
# Búsquedas máximas al día (la cuota gratis da ~100)
SEARCH_DAILY_LIMIT=95

# ===== MODO INTERNET (Render) =====
# PUBLIC_URL=https://karaoke-party.onrender.com
PUBLIC_URL=

# ===== MODO LOCAL =====
# Vacío = se detecta la IP sola. Si el QR no abre, pon la IP que sale en la consola.
PUBLIC_HOST=

# Portal cautivo para el WiFi cerrado del karaoke (router barato, ver README sección 3)
# 1 = la PC contesta el DNS y cualquier página que abran los invitados los lleva al karaoke
CAPTIVE=0

# QR para unirse al WiFi en la pantalla (vacío = no se muestra)
WIFI_SSID=
WIFI_PASS=
